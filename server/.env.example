# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=5050
# The URL the React app runs on. CORS only allows this origin.
CLIENT_URL=http://localhost:5173

# ── Database (MongoDB Atlas) ────────────────────────────
# Atlas → Database → Connect → Drivers. Put the database name before the "?".
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/webx_finance?retryWrites=true&w=majority

# ── Auth ────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d
# Defaults to true in production. Set COOKIE_SAMESITE=none (and secure) only if
# the client and API are on different sites.
# COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Number of reverse proxies in front of the app (1 on Render/Railway/Nginx).
TRUST_PROXY=0

# ── Uploads ─────────────────────────────────────────────
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# ── Seed (npm run seed) ─────────────────────────────────
SEED_OWNER_NAME=Owner
SEED_OWNER_EMAIL=owner@example.com
# At least 10 characters with a letter and a number.
SEED_OWNER_PASSWORD=
